NODE_ENV=production
PORT=8000
MONGO_URI=mongodb://mongo:27017/jobnet
JWT_SECRET=replace-with-a-cryptographically-random-secret
JWT_EXPIRES_IN=1d
CLIENT_URL=https://jobs.example.com
SERVER_URL=https://api.jobs.example.com
COOKIE_NAME=token
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true
COOKIE_MAX_AGE_MS=86400000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
BODY_LIMIT=100kb
TRUST_PROXY=true
LOG_LEVEL=info
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
